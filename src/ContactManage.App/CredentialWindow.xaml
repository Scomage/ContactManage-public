<Window x:Class="ContactManage.App.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" SizeToContent="Height" Width="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Foreground="#B00020" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock Text="User name" Margin="0,12,0,2"/>
        <TextBox x:Name="UserBox"/>
        <TextBlock Text="Password" Margin="0,10,0,2"/>
        <PasswordBox x:Name="PasswordBox"/>
        <CheckBox x:Name="RememberBox" AutomationProperties.AutomationId="RememberCheck" Margin="0,12,0,0"
                  Content="Remember this password on this PC"/>
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="The password is sent only to this server. If remembered, Windows Credential Manager keeps it encrypted for your Windows login."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Sign in" Width="90" Padding="0,4" IsDefault="True" Margin="0,0,8,0" Click="SignIn_Click"/>
            <Button Content="Cancel" Width="90" Padding="0,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
