<Window x:Class="ContactManage.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ContactManage - Review duplicates" Height="700" Width="1180" MinHeight="420" MinWidth="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Review duplicates"/>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Contacts that look like the same person are listed below. Choose to merge them or keep them separate, then settle any fields where they disagree."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <CheckBox AutomationProperties.AutomationId="AttentionOnlyCheck" DockPanel.Dock="Top" Margin="0,0,0,6" Content="Only show items that need attention"
                          IsChecked="{Binding AttentionOnly}"/>
                <ListBox AutomationProperties.AutomationId="GroupList" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Status}" Foreground="Gray" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ReasonsText}" Foreground="Gray" Margin="0,2,0,8" TextWrapping="Wrap"/>

                    <ListView ItemsSource="{Binding Members}" Height="140">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Emails" Width="190" DisplayMemberBinding="{Binding Emails}"/>
                                <GridViewColumn Header="Phones" Width="120" DisplayMemberBinding="{Binding Phones}"/>
                                <GridViewColumn Header="Company" Width="90" DisplayMemberBinding="{Binding Company}"/>
                                <GridViewColumn Header="Labels" Width="80" DisplayMemberBinding="{Binding Labels}"/>
                                <GridViewColumn Header="Folder" Width="110" DisplayMemberBinding="{Binding Folder}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton AutomationProperties.AutomationId="MergeRadio" GroupName="decision" Content="Merge into one contact" IsChecked="{Binding IsMerge}" Margin="0,0,20,0"/>
                        <RadioButton AutomationProperties.AutomationId="KeepSeparateRadio" GroupName="decision" Content="Keep separate" IsChecked="{Binding IsKeepSeparate}" Margin="0,0,20,0"/>
                        <RadioButton AutomationProperties.AutomationId="RemoveRadio" GroupName="decision" Content="Remove all of these (obsolete)" IsChecked="{Binding IsRemove}"
                                     ToolTip="None of these contacts is kept. They are deleted from any folder you replace; a new folder or a file simply leaves them out."/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowConflicts, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <TextBlock FontWeight="SemiBold" Text="These fields differ. Pick the value to keep:"/>
                        <ItemsControl ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Header="{Binding FieldLabel}" Margin="0,8,0,0" Padding="8">
                                        <ItemsControl ItemsSource="{Binding Choices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <RadioButton IsChecked="{Binding IsChecked}" Content="{Binding Label}" VerticalAlignment="Center"/>
                                                        <TextBox Width="260" Margin="8,0,0,0"
                                                                 Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                                 Text="{Binding DataContext.CustomText, RelativeSource={RelativeSource AncestorType=GroupBox}, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" AutomationProperties.AutomationId="ReviewStatus" Text="{Binding StatusText}"/>
            <Button AutomationProperties.AutomationId="FinishButton" DockPanel.Dock="Right" Content="Finish" Width="90" Padding="0,4"
                    IsEnabled="{Binding CanFinish}" Click="Finish_Click"/>
            <Button AutomationProperties.AutomationId="BackButton" DockPanel.Dock="Right" Content="Back" Width="90" Padding="0,4" Margin="0,0,8,0" Click="Back_Click"/>
        </DockPanel>
    </Grid>
</Window>
