<Window x:Class="ContactManage.App.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Where are your contacts?" SizeToContent="Height" Width="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Where are your contacts?" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,16" Foreground="Gray" TextWrapping="Wrap"
                   Text="Choose where to read the contacts you want to tidy up. You can change this later with Switch source."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="OnlineTile" Grid.Column="0" Margin="0,0,8,0" Padding="14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    AutomationProperties.AutomationId="OnlineTile" AutomationProperties.Name="Online account" Click="Online_Click">
                <StackPanel>
                    <TextBlock Text="Online account" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Gmail, or Outlook.com, Hotmail and Microsoft 365. Sign in in the browser. No mail program is needed."/>
                </StackPanel>
            </Button>

            <Button x:Name="MailTile" Grid.Column="1" Margin="4,0,4,0" Padding="14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    AutomationProperties.AutomationId="MailTile" AutomationProperties.Name="A mail program on this PC" Click="Mail_Click">
                <StackPanel>
                    <TextBlock Text="A mail program on this PC" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MailText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <Button x:Name="DemoTile" Grid.Column="2" Margin="8,0,0,0" Padding="14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    AutomationProperties.AutomationId="DemoTile" AutomationProperties.Name="Try the demo" Click="Demo_Click">
                <StackPanel>
                    <TextBlock Text="Try the demo" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Made-up contacts. Nothing real is read or changed."/>
                </StackPanel>
            </Button>
        </Grid>

        <CheckBox x:Name="RememberCheck" Margin="0,18,0,0" AutomationProperties.AutomationId="RememberCheck"
                  Content="Remember my choice and skip this screen next time (Switch source brings it back)"/>
    </StackPanel>
</Window>
