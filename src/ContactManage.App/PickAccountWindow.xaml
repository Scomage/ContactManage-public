<Window x:Class="ContactManage.App.PickAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name this Google account" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Question" TextWrapping="Wrap"/>
        <ComboBox x:Name="NameBox" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="90" Padding="0,4" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
